# General config
NODE_ENV=development
PORT=5000

# Supabase database config (Direct PostgreSQL Connection String)
# Example: postgresql://postgres:your-password@db.xxxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustgov

# Supabase API keys (for future phases if required)
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Authentication (JWT Secret)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Blockchain Config (For later phases)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=your-blockchain-private-key-placeholder
CONTRACT_ADDRESS=

# IVR Provider Config (For later phases)
IVR_PROVIDER=mock
IVR_API_KEY=mock-api-key
IVR_WEBHOOK_SECRET=mock-webhook-secret
