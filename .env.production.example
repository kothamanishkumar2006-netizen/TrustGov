# ============================================================
# TRUSTGOV PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# ============================================================

# Application Environment & Server
NODE_ENV=production
PORT=5000

# Database Configuration (PostgreSQL with SSL enabled)
DATABASE_URL=postgresql://trustgov_user:<STRONG_DB_PASSWORD>@db.internal:5432/trustgov_production?sslmode=require
DB_HOST=db.internal
DB_PORT=5432
DB_NAME=trustgov_production
DB_USER=trustgov_user
DB_PASSWORD=<STRONG_DB_PASSWORD>
DB_SSL=true

# Authentication & JWT Security (Generate with: openssl rand -base64 64)
# Must NOT be default or development placeholder in production
JWT_SECRET=<STRONG_64_CHAR_RANDOM_SECRET>
JWT_ISSUER=trustgov-auth-service
JWT_AUDIENCE=trustgov-api

# Network & CORS Security
# Explicit production frontend origins (comma-separated if multiple, never wildcard *)
FRONTEND_URL=https://verify.trustgov.gov.in
CLIENT_URL=https://verify.trustgov.gov.in
CORS_ORIGINS=https://verify.trustgov.gov.in,https://admin.trustgov.gov.in

# Blockchain Anchor Configuration (Sepolia Testnet / Consortium L2)
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>
BLOCKCHAIN_PRIVATE_KEY=<SECURE_DEPLOYER_PRIVATE_KEY_FROM_KMS>
TRUSTGOV_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000

# IVR Telephony Gateway Configuration (Twilio / Exotel / Plivo)
IVR_PROVIDER=twilio
IVR_PROVIDER_API_KEY=<SECURE_TELEPHONY_ACCOUNT_SID>
IVR_PROVIDER_SECRET=<SECURE_TELEPHONY_AUTH_TOKEN>
IVR_PHONE_NUMBER=+918000000000

# Rate Limiting & Storage
RATE_LIMIT_MAX=100
MAX_UPLOAD_SIZE_BYTES=10485760
STORAGE_DIRECTORY=/var/trustgov/storage/evidence
